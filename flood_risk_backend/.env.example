# Copy this file to .env and adjust as needed. All values here are optional —
# sensible defaults are used if you don't set them (see app/config.py).

# --- Database ---
# Default: SQLite file at the project root (zero setup). Uncomment to use Postgres instead:
# DATABASE_URL=postgresql+psycopg2://flood_user:flood_pass@localhost:5432/flood_risk
DATABASE_URL=sqlite:///./flood_risk.db

# --- Model artifacts (defaults point at models_artifacts/ in this repo) ---
# MODEL_PATH=./models_artifacts/model.joblib
# EXPLAINER_PATH=./models_artifacts/explainer.joblib
# FEATURE_LIST_PATH=./models_artifacts/feature_list.json
# MODEL_METADATA_PATH=./models_artifacts/metadata.json

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Misc ---
TOP_N_SHAP_FEATURES=5
